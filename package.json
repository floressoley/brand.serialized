{
  "name": "serialized-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:brand-kit": "npm run dev -w apps/brand-kit",
    "dev:landing": "npm run dev -w apps/landing",
    "build": "tsc -b && npm run build -ws --if-present",
    "preview:brand-kit": "npm run preview -w apps/brand-kit",
    "preview:landing": "npm run preview -w apps/landing"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
